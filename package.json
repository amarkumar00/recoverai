{
  "name": "recoverai",
  "version": "0.1.0",
  "private": true,
  "description": "RecoverAI — a bounded payment-failure recovery prototype for Razorpay AI Buildathon 2026.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:hardening": "vitest run src/adapters/razorpay/__tests__/adapter-contract-parity.test.ts src/audit/__tests__/sqlite-chain.integration.test.ts src/lib/db/migration-consistency.test.ts src/recovery/__tests__/action-executor.integration.test.ts src/webhooks/__tests__/http-handler.integration.test.ts src/webhooks/__tests__/ingestion.integration.test.ts",
    "integrity:check": "vitest run src/digital-twin/__tests__/generator.test.ts src/digital-twin/__tests__/leakage-boundary.test.ts src/evaluation/__tests__/golden-report.test.ts src/dashboard/__tests__/dashboard.test.tsx",
    "db:check": "vitest run src/lib/db/migration-consistency.test.ts",
    "db:migrate": "node scripts/migrate-db.mjs",
    "audit:dependencies": "npm audit --audit-level=high --omit=dev",
    "hygiene:check": "node scripts/repository-hygiene.mjs",
    "smoke:production": "node scripts/production-smoke.mjs",
    "smoke:test-mode:optional": "node scripts/optional-test-mode-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run db:check && npm run integrity:check && npm run test && npm run build && npm run audit:dependencies && npm run hygiene:check && npm run smoke:production"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "tailwind-merge": "3.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
